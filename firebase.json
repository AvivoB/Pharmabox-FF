{
  "functions": {
    "source": "functions"
  },
  "emulators": {
    "auth": {
      "port": 4300
    },
    "functions": {
      "port": 4200
    },
    "firestore": {
      "port": 4100
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "hosting": [
    {
      "target": "pharmaff-dab40",
      "public": "hosting/pharma-box.fr",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    },
    {
      "target": "backoffice-pharmabox",
      "public": "hosting/backoffice/build",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [ {
        "source": "**",
        "destination": "/index.html"
      }]
    }
  ]
}
