{
  "functions": {
    "source": "functions"
  },
  "emulators": {
    "auth": {
      "port": 4300
    },
    "functions": {
      "port": 4200
    },
    "firestore": {
      "port": 4100
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "hosting": [
    {
      "target": "site-principal",
      "public": "hosting",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },
    {
      "target": "admin",
      "public": "backoffice",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },
    {
      "target": "webapp-pharmabox",
      "public": "hosting/app",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    }
  ]
}
